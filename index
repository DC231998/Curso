function navigate(id){
  currentSection=id;
  renderSidebar();
  document.getElementById('sidebar').classList.remove('open');
  let html;
  if(id==='inicio') html=renderInicio();
  else if(id==='irregulares') html=renderIrregulares();
  else if(id==='progreso') html=renderProgreso();
  else if(id==='mascota') html=renderMascota();
  else { const r=renderersByLevel[progress.level]; html = r&&r[id] ? r[id]() : '<p>Sección no encontrada.</p>'; }
  document.getElementById('content').innerHTML=html;
  if(id==='inicio'){ const el=document.getElementById('inicio-progress'); if(el) el.innerHTML=miniProgress(); }
  if(id==='progreso'){ renderProgressPage(); }
  window.scrollTo(0,0);
}

