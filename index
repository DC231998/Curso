<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cuaderno de Inglés — Desde Cero (A1)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1B3A6B;
  --ink-soft:#3A5580;
  --paper:#F0F1E9;
  --paper-line:#C9CCB8;
  --margin-red:#C0392B;
  --chalk-yellow:#E3A73B;
  --sage:#4F6D5A;
  --card:#FAFAF4;
  --shadow:rgba(27,58,107,.12);
  --text:#20242A;
  --text-dim:#5b5f57;
  --radius:10px;
}
[data-theme="dark"]{
  --ink:#EADFA0;
  --ink-soft:#C9BE86;
  --paper:#151A22;
  --paper-line:#2b3140;
  --margin-red:#E0685A;
  --chalk-yellow:#E3A73B;
  --sage:#7FA98C;
  --card:#1C222C;
  --shadow:rgba(0,0,0,.4);
  --text:#E9E9E2;
  --text-dim:#9aa09c;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--paper);
  color:var(--text);
  font-family:'Source Serif 4', Georgia, serif;
  min-height:100vh;
  transition:background .3s,color .3s;
}
.hand{font-family:'Caveat',cursive;}
.mono{font-family:'JetBrains Mono',monospace;}
#app{display:flex;min-height:100vh;}
#sidebar{
  width:260px;flex-shrink:0;
  background:var(--card);
  border-right:2px solid var(--paper-line);
  padding:22px 14px;
  position:sticky;top:0;height:100vh;overflow-y:auto;
}
#sidebar h1{
  font-family:'Caveat',cursive;font-weight:700;
  font-size:2.1rem;color:var(--ink);margin:0 0 2px 6px;line-height:1;
}
#sidebar .sub{margin:0 0 18px 6px;font-size:.78rem;color:var(--text-dim);letter-spacing:.03em;text-transform:uppercase;}
.navgroup{margin-bottom:14px;}
.navgroup-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim);margin:14px 0 6px 8px;}
.navbtn{
  display:flex;align-items:center;gap:9px;
  width:100%;text-align:left;background:none;border:none;
  padding:8px 10px;border-radius:8px;cursor:pointer;
  font-family:inherit;font-size:.92rem;color:var(--text);
  transition:background .15s;
}
.navbtn .ic{width:20px;text-align:center;flex-shrink:0;}
.navbtn:hover{background:var(--paper);}
.navbtn.active{background:var(--ink);color:var(--card);}
.navbtn .badgeDot{margin-left:auto;font-size:.7rem;color:var(--sage);}
#toolbar{display:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px dashed var(--paper-line);}
#toolbar button{
  flex:1;background:var(--paper);border:1px solid var(--paper-line);
  border-radius:8px;padding:8px 4px;cursor:pointer;font-size:1rem;color:var(--text);
}
main{flex:1;padding:34px 44px 80px;max-width:900px;}
.pagehead{position:relative;margin-bottom:26px;padding-left:20px;border-left:4px solid var(--margin-red);}
.pagehead .eyebrow{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--sage);font-weight:600;}
.pagehead h2{font-family:'Caveat',cursive;font-size:2.6rem;margin:2px 0 4px;color:var(--ink);font-weight:700;}
.pagehead p{margin:0;color:var(--text-dim);max-width:64ch;}
.card{
  background:var(--card);border:1px solid var(--paper-line);border-radius:var(--radius);
  padding:20px 22px;margin-bottom:20px;box-shadow:0 2px 10px var(--shadow);
}
.card h3{font-family:'Caveat',cursive;font-size:1.6rem;color:var(--ink);margin:0 0 10px;}
table{width:100%;border-collapse:collapse;font-size:.92rem;}
th{text-align:left;color:var(--sage);font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;padding:6px 8px;border-bottom:2px solid var(--paper-line);}
td{padding:7px 8px;border-bottom:1px solid var(--paper-line);vertical-align:top;}
tr:last-child td{border-bottom:none;}
.pron{color:var(--sage);font-family:'JetBrains Mono',monospace;font-size:.85em;}
.pill{display:inline-block;background:var(--paper);border:1px solid var(--paper-line);border-radius:999px;padding:2px 10px;font-size:.78rem;color:var(--text-dim);}
.speakbtn{
  border:1px solid var(--paper-line);background:var(--paper);border-radius:7px;
  cursor:pointer;padding:2px 8px;font-size:.85rem;color:var(--ink);margin-left:4px;
}
.speakbtn:hover{background:var(--chalk-yellow);}
.dialogue .line{margin-bottom:10px;padding:10px 14px;border-radius:10px;background:var(--paper);}
.dialogue .line b{color:var(--ink);}
.dialogue .line .pron{display:block;margin-top:2px;}
.note{
  background:linear-gradient(135deg,rgba(227,167,59,.18),rgba(227,167,59,.08));
  border:1px solid var(--chalk-yellow);border-radius:8px;padding:12px 16px;margin:14px 0;font-size:.92rem;
}
.note b{color:var(--ink);}
.culturenote{border-left:3px solid var(--sage);padding:8px 14px;margin:10px 0;background:var(--paper);border-radius:0 8px 8px 0;font-size:.9rem;}
.mistake{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:12px 0;border-bottom:1px dashed var(--paper-line);}
.mistake:last-child{border-bottom:none;}
.mistake .bad{color:var(--margin-red);text-decoration:line-through;font-size:.92rem;}
.mistake .good{color:var(--sage);font-weight:600;font-size:.92rem;}
.mistake .tip{grid-column:1/-1;font-size:.85rem;color:var(--text-dim);margin-top:2px;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media(max-width:800px){.grid2,.grid3{grid-template-columns:1fr;} main{padding:24px 18px 60px;} #sidebar{position:fixed;left:-280px;z-index:20;transition:left .2s;box-shadow:4px 0 18px var(--shadow);} #sidebar.open{left:0;} #menuToggle{display:block !important;}}
#menuToggle{display:none;position:fixed;top:14px;left:14px;z-index:21;background:var(--ink);color:var(--card);border:none;border-radius:8px;padding:8px 12px;font-size:1.1rem;cursor:pointer;}

.qcard{background:var(--paper);border:1px solid var(--paper-line);border-radius:8px;padding:14px 16px;margin-bottom:12px;}
.qcard .qtext{margin-bottom:8px;font-weight:600;}
.opt{display:block;width:100%;text-align:left;background:var(--card);border:1px solid var(--paper-line);border-radius:7px;padding:8px 12px;margin-bottom:6px;cursor:pointer;font-family:inherit;color:var(--text);}
.opt:hover{border-color:var(--ink);}
.opt.correct{background:rgba(79,109,90,.25);border-color:var(--sage);}
.opt.incorrect{background:rgba(192,57,43,.2);border-color:var(--margin-red);}
input.fillblank{font-family:inherit;font-size:.95rem;padding:6px 10px;border-radius:6px;border:1px solid var(--paper-line);width:180px;background:var(--card);color:var(--text);}
.checkbtn,.actionbtn{
  background:var(--ink);color:var(--card);border:none;border-radius:8px;
  padding:9px 18px;cursor:pointer;font-family:inherit;font-size:.9rem;font-weight:600;
}
.actionbtn.secondary{background:transparent;color:var(--ink);border:1px solid var(--ink);}
.scorebox{margin-top:10px;padding:10px 14px;border-radius:8px;background:var(--card);border:1px solid var(--paper-line);font-size:.9rem;}
.wordbank{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0;min-height:40px;padding:10px;border:1px dashed var(--paper-line);border-radius:8px;}
.wordchip{background:var(--card);border:1px solid var(--paper-line);border-radius:6px;padding:5px 12px;cursor:pointer;font-family:'JetBrains Mono',monospace;font-size:.88rem;}
.wordchip:hover{background:var(--chalk-yellow);}
.answerline{min-height:44px;display:flex;flex-wrap:wrap;gap:8px;padding:10px;border-bottom:2px solid var(--margin-red);margin-bottom:10px;}
.answerline .wordchip{background:var(--paper-line);}
.badge{display:inline-flex;align-items:center;gap:6px;background:var(--card);border:1px solid var(--chalk-yellow);border-radius:999px;padding:6px 14px;font-size:.85rem;margin:4px 6px 4px 0;}
.progressbarwrap{background:var(--paper-line);border-radius:999px;height:10px;overflow:hidden;margin:8px 0;}
.progressbarfill{background:var(--sage);height:100%;transition:width .4s;}
.micbtn{background:var(--margin-red);color:#fff;border:none;border-radius:999px;padding:8px 14px;cursor:pointer;font-family:inherit;}
.micbtn.listening{background:var(--sage);}
@media print{
  #sidebar,#menuToggle,.speakbtn,.micbtn,.checkbtn,.actionbtn,#toolbar{display:none !important;}
  main{max-width:100%;padding:0;}
  body{background:#fff;color:#000;}
  .card{box-shadow:none;border:1px solid #ccc;break-inside:avoid;}
}
</style>
</head>
<body>
<button id="menuToggle" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>
<div id="app">
  <aside id="sidebar"></aside>
  <main id="content"></main>
</div>

<script>
/* ============ SHARED DATA (level-independent) ============ */
const irregularVerbs=[
["be","was/were","been","ser/estar"],["go","went","gone","ir"],["have","had","had","tener"],
["do","did","done","hacer"],["see","saw","seen","ver"],["eat","ate","eaten","comer"],
["drink","drank","drunk","beber"],["make","made","made","hacer/fabricar"],["take","took","taken","tomar"],
["give","gave","given","dar"],["come","came","come","venir"],["get","got","gotten","obtener"],
["know","knew","known","saber/conocer"],["think","thought","thought","pensar"],["say","said","said","decir"],
["write","wrote","written","escribir"],["read","read","read","leer"],["speak","spoke","spoken","hablar"],
["buy","bought","bought","comprar"],["bring","brought","brought","traer"],["find","found","found","encontrar"],
["feel","felt","felt","sentir"],["leave","left","left","salir/dejar"],["meet","met","met","conocer/reunir"],
["pay","paid","paid","pagar"],["run","ran","run","correr"],["sit","sat","sat","sentarse"],
["sleep","slept","slept","dormir"],["tell","told","told","contar/decir"],["understand","understood","understood","entender"],
["break","broke","broken","romper"],["choose","chose","chosen","elegir"],["build","built","built","construir"],
["catch","caught","caught","atrapar"],["teach","taught","taught","enseñar"],["sell","sold","sold","vender"],
["lose","lost","lost","perder"],["win","won","won","ganar"],["fall","fell","fallen","caer"],
["forget","forgot","forgotten","olvidar"],["hide","hid","hidden","esconder"],["hold","held","held","sostener"],
["keep","kept","kept","mantener"],["lend","lent","lent","prestar"],["ride","rode","ridden","montar"],
["rise","rose","risen","levantarse/subir"],["shake","shook","shaken","sacudir"],["shine","shone","shone","brillar"],
["shoot","shot","shot","disparar"],["spend","spent","spent","gastar"],["steal","stole","stolen","robar"],
["swim","swam","swum","nadar"],["throw","threw","thrown","lanzar"],["wake","woke","woken","despertar"],
["wear","wore","worn","vestir"]];

const LEVELS=[
 {id:'A1',label:'A1 · Principiante',tag:'Fundamentos absolutos'},
 {id:'A2',label:'A2 · Elemental',tag:'Pasado, futuro, comparativos'},
 {id:'B1',label:'B1 · Intermedio',tag:'Presente perfecto, condicionales, pasiva'},
 {id:'B2',label:'B2/C1 · Avanzado',tag:'Reported speech, inversión, inglés formal'}
];

/* ============ STATE / STORAGE ============ */
let progress={quizzes:{},badges:[],theme:'light',level:'A1',pet:null};
async function loadProgress(){
  try{ const r=await window.storage.get('progress',false); if(r&&r.value){progress=Object.assign({quizzes:{},badges:[],theme:'light',level:'A1',pet:null},JSON.parse(r.value));} }catch(e){}
  applyTheme();
}
async function saveProgress(){ try{ await window.storage.set('progress',JSON.stringify(progress),false); }catch(e){} }
function applyTheme(){ document.body.setAttribute('data-theme', progress.theme==='dark'?'dark':'light'); }
function toggleTheme(){ progress.theme = progress.theme==='dark'?'light':'dark'; applyTheme(); saveProgress(); }
function awardBadge(name){
  if(!progress.badges.includes(name)){ progress.badges.push(name); saveProgress(); setTimeout(()=>alert('🏅 ¡Insignia obtenida! '+name),150); }
}
function recordQuiz(id,score,total){
  const prevStage=petStage();
  progress.quizzes[id]={score,total,date:new Date().toISOString().slice(0,10)};
  if(score/total>=0.7) awardBadge('Aprobado: '+id);
  saveProgress(); renderSidebar();
  const newStage=petStage();
  if(newStage>prevStage && progress.pet){
    setTimeout(function(){ alert('✨ ¡'+progress.pet.name+' evolucionó! Ve a "Mi mascota" para verlo.'); },300);
  }
}

/* ============ MASCOTA ============ */
const PETS={
 owl:{label:'Búho',base:'🦉'}, fox:{label:'Zorro',base:'🦊'},
 cat:{label:'Gato',base:'🐱'}, dragon:{label:'Dragón',base:'🐉'},
 panda:{label:'Panda',base:'🐼'}, penguin:{label:'Pingüino',base:'🐧'}
};
const PET_STAGES=[
 {min:0,label:'Sin empezar',accessory:'',emoji:'🥚',desc:'Aprueba el examen de A1 para que tu mascota nazca.'},
 {min:1,label:'Aprendiz A1',accessory:'🎒',emoji:'',desc:'¡Acaba de nacer y ya lleva su mochila!'},
 {min:2,label:'Explorador A2',accessory:'👓',emoji:'',desc:'Ahora ve el mundo con más claridad.'},
 {min:3,label:'Estudiante B1',accessory:'🎓',emoji:'',desc:'Se ha ganado su birrete de estudiante.'},
 {min:4,label:'Maestro B2/C1',accessory:'👑',emoji:'',desc:'¡Nivel máximo! Domina el inglés avanzado.'}
];
function examPassed(level){ const q=progress.quizzes[level+'-examen']; return !!(q && q.score/q.total>=0.7); }
function petStage(){ let s=0; ['A1','A2','B1','B2'].forEach(function(l){ if(examPassed(l)) s++; }); return s; }
function petBadgeHtml(size){
  size=size||'2.4rem';
  if(!progress.pet) return '<span style="font-size:'+size+'">🥚</span>';
  const stage=PET_STAGES[petStage()];
  const species=PETS[progress.pet.species];
  const glyph = stage.min===0 ? stage.emoji : species.base;
  return '<span style="font-size:'+size+'">'+glyph+'</span>'+(stage.accessory?'<span style="font-size:calc('+size+' * 0.55); margin-left:-10px; vertical-align:top;">'+stage.accessory+'</span>':'');
}
function setLevel(lvl){
  progress.level=lvl; saveProgress();
  const avail=renderersByLevel[lvl];
  if(!avail[currentSection]) currentSection='m1';
  renderSidebar();
  navigate(currentSection);
}

/* ============ SPEECH ============ */
function speak(text){
  try{ const u=new SpeechSynthesisUtterance(text); u.lang='en-US'; u.rate=0.92; speechSynthesis.cancel(); speechSynthesis.speak(u); }catch(e){}
}
function speakBtn(text){ return '<button class="speakbtn" onclick="speak('+JSON.stringify(text)+')" title="Escuchar">🔊</button>'; }
function getRecognition(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR) return null;
  const r=new SR(); r.lang='en-US'; r.interimResults=false; r.maxAlternatives=1; return r;
}
function practicePron(target, btn, resultId){
  const SRAvail = window.SpeechRecognition || window.webkitSpeechRecognition;
  const resEl=document.getElementById(resultId);
  if(!SRAvail){ resEl.textContent='⚠️ Tu navegador no soporta reconocimiento de voz. Prueba en Chrome de escritorio o Android.'; return; }
  const rec=getRecognition();
  btn.classList.add('listening'); btn.textContent='🎙️ Escuchando...'; resEl.textContent='';
  rec.onresult=(e)=>{
    const heard=e.results[0][0].transcript.trim().toLowerCase();
    const norm=s=>s.toLowerCase().replace(/[^a-z ]/g,'').trim();
    const match = norm(heard).includes(norm(target).split(' ').slice(0,3).join(' ')) || norm(heard)===norm(target);
    resEl.innerHTML = 'Escuché: <i>"'+heard+'"</i><br>'+(match?'✅ ¡Muy bien! Suena correcto.':'🔁 Casi. Escucha el modelo y repite.');
  };
  rec.onerror=()=>{ resEl.textContent='No se detectó audio. Intenta de nuevo y permite el micrófono.'; };
  rec.onend=()=>{ btn.classList.remove('listening'); btn.textContent='🎤 Practicar pronunciación'; };
  rec.start();
}

/* ============ RENDER HELPERS ============ */
function table(headers, rows, pronCols){
  pronCols=pronCols||[];
  let h='<table><thead><tr>'+headers.map(function(x){return '<th>'+x+'</th>';}).join('')+'</tr></thead><tbody>';
  rows.forEach(function(r){
    h+='<tr>'+r.map(function(c,i){return '<td>'+(pronCols.includes(i)?'<span class="pron">'+c+'</span>':c)+'</td>';}).join('')+'</tr>';
  });
  return h+'</tbody></table>';
}
function head(eyebrow,title,desc){
  return '<div class="pagehead"><div class="eyebrow">'+eyebrow+'</div><h2>'+title+'</h2><p>'+desc+'</p></div>';
}

function mcQuiz(id, questions){
  let html='<div id="'+id+'" class="quiz">';
  questions.forEach(function(item,qi){
    html+='<div class="qcard" data-qi="'+qi+'"><div class="qtext">'+(qi+1)+'. '+item.q+'</div>'+
      item.options.map(function(op,oi){return '<button class="opt" onclick="selectOpt(\''+id+'\','+qi+','+oi+')">'+op+'</button>';}).join('')+
      '</div>';
  });
  html+='<button class="checkbtn" onclick="checkQuiz(\''+id+'\')">Revisar respuestas</button><div class="scorebox" id="'+id+'-score" style="display:none"></div></div>';
  window['__quiz_'+id]={questions:questions, chosen:new Array(questions.length).fill(null)};
  return html;
}
function selectOpt(id,qi,oi){
  const data=window['__quiz_'+id]; data.chosen[qi]=oi;
  const card=document.querySelector('#'+id+' [data-qi="'+qi+'"]');
  card.querySelectorAll('.opt').forEach(function(b,i){ b.style.outline = i===oi?'2px solid var(--ink)':'none'; });
}
function checkQuiz(id){
  const data=window['__quiz_'+id]; let correct=0;
  data.questions.forEach(function(item,qi){
    const card=document.querySelector('#'+id+' [data-qi="'+qi+'"]');
    const btns=card.querySelectorAll('.opt');
    btns.forEach(function(b,oi){
      b.classList.remove('correct','incorrect');
      if(oi===item.a) b.classList.add('correct');
      else if(oi===data.chosen[qi]) b.classList.add('incorrect');
    });
    if(data.chosen[qi]===item.a) correct++;
  });
  const box=document.getElementById(id+'-score');
  box.style.display='block';
  box.innerHTML='Puntaje: <b>'+correct+' / '+data.questions.length+'</b> ('+Math.round(100*correct/data.questions.length)+'%)';
  recordQuiz(id, correct, data.questions.length);
}

function wordOrderExercise(items){
  let html='<div class="card"><h3>🧩 Ordena las palabras</h3><p>Toca las palabras en el orden correcto. Toca una palabra en tu respuesta para quitarla.</p>';
  items.forEach(function(item,idx){
    const scrambled=item.words.slice().sort(function(){return Math.random()-0.5;});
    html+='<div class="wo" data-idx="'+idx+'" data-answer="'+item.answer+'">'+
      '<div class="answerline" id="wo-ans-'+idx+'"></div>'+
      '<div class="wordbank" id="wo-bank-'+idx+'">'+scrambled.map(function(w){return '<span class="wordchip" onclick="woPick('+idx+',this)">'+w+'</span>';}).join('')+'</div>'+
      '<button class="actionbtn secondary" onclick="woCheck('+idx+')" style="font-size:.8rem;padding:5px 12px;">Revisar</button> '+
      '<span class="pill" id="wo-result-'+idx+'"></span><hr style="border:none;border-top:1px dashed var(--paper-line);margin:14px 0;"></div>';
  });
  return html+'</div>';
}
function woPick(idx,el){ document.getElementById('wo-ans-'+idx).appendChild(el); el.setAttribute('onclick','woReturn('+idx+',this)'); }
function woReturn(idx,el){ document.getElementById('wo-bank-'+idx).appendChild(el); el.setAttribute('onclick','woPick('+idx+',this)'); }
function woCheck(idx){
  const ansDiv=document.getElementById('wo-ans-'+idx);
  const built=[].slice.call(ansDiv.children).map(function(c){return c.textContent;}).join(' ');
  const correct=document.querySelector('.wo[data-idx="'+idx+'"]').dataset.answer;
  const res=document.getElementById('wo-result-'+idx);
  if(built.trim()===correct){ res.textContent='✅ ¡Correcto!'; res.style.color='var(--sage)'; awardBadge('Constructor de oraciones'); }
  else { res.textContent='❌ Intenta de nuevo'; res.style.color='var(--margin-red)'; }
}

function dictationExercise(items){
  let html='<div class="card"><h3>🎧 Dictado</h3><p>Escucha la oración y escríbela exactamente como la oyes.</p>';
  items.forEach(function(s,i){
    html+='<div style="margin-bottom:14px;">'+speakBtn(s)+' <span class="pill">Oración '+(i+1)+'</span><br>'+
      '<input type="text" class="fillblank" style="width:340px;margin-top:6px;" id="dict-'+i+'" placeholder="Escribe lo que escuchas...">'+
      '<button class="actionbtn secondary" style="font-size:.8rem;padding:5px 12px;" onclick="dictCheck('+i+','+JSON.stringify(s)+')">Revisar</button>'+
      '<span class="pill" id="dict-result-'+i+'"></span></div>';
  });
  return html+'</div>';
}
function dictCheck(i,correctSentence){
  const val=document.getElementById('dict-'+i).value.trim().toLowerCase().replace(/[.?!]/g,'');
  const correct=correctSentence.toLowerCase().replace(/[.?!]/g,'');
  const res=document.getElementById('dict-result-'+i);
  if(val===correct){ res.textContent='✅ ¡Perfecto!'; res.style.color='var(--sage)'; awardBadge('Oído de oro (dictado)'); }
  else{ res.textContent='❌ Revisa de nuevo (mayúsculas/puntuación no cuentan)'; res.style.color='var(--margin-red)'; }
}

function pronunciationExercise(items){
  let html='<div class="card"><h3>🎤 Práctica de pronunciación</h3><p>Escucha el modelo, luego presiona el micrófono y repite en voz alta. Funciona mejor en Chrome de escritorio o Android.</p>';
  items.forEach(function(s,i){
    html+='<div style="margin-bottom:16px;"><b>'+s+'</b> '+speakBtn(s)+'<br>'+
