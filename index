  '<div class="card"><h3>Nivel actual: '+lv.label+'</h3><p>'+lv.tag+'. Cambia de nivel en cualquier momento desde el menú lateral — tu progreso se guarda por separado en cada uno.</p>'+
  '<div class="grid3">'+LEVELS.map(function(l){return '<div class="note" style="cursor:pointer" onclick="setLevel(\''+l.id+'\')"><b>'+(l.id===progress.level?'🟢 ':'')+l.label+'</b><br>'+l.tag+'</div>';}).join('')+'</div></div>'+
  '<div class="card"><h3>Tu progreso</h3><div id="inicio-progress"></div></div>';
}
function renderIrregulares(){
  return head('Referencia general','Verbos irregulares','Consulta esta tabla en cualquier momento — base, pasado y participio de los verbos más comunes, útil desde A2 hasta C1.')+
  '<div class="card">'+table(['Base','Pasado','Participio','Significado',''],irregularVerbs.map(function(v){return [v[0],v[1],v[2],v[3],speakBtn(v[0]+' '+v[1].split('/')[0]+' '+v[2])];}))+'</div>';
}
function renderMascota(){
  const stage=petStage();
  const st=PET_STAGES[stage];
  const nextSt=PET_STAGES[stage+1];
  const levelOrder=['A1','A2','B1','B2'];
  let html=head('Mi compañero','Mi mascota','Tu mascota evoluciona cada vez que apruebas el examen final de un nivel (70% o más).');

  if(!progress.pet){
    html+='<div class="card"><h3>🥚 Elige a tu compañero</h3><p>Elige una especie y ponle un nombre. Empezará como huevo y nacerá en cuanto apruebes el examen de A1.</p>'+
      '<div class="grid3" id="petPicker">'+Object.entries(PETS).map(function(e){
        return '<div class="note" style="text-align:center;cursor:pointer;" onclick="pickPetSpecies(\''+e[0]+'\')" data-species="'+e[0]+'"><span style="font-size:2.4rem;">'+e[1].base+'</span><br><b>'+e[1].label+'</b></div>';
      }).join('')+'</div>'+
      '<div style="margin-top:14px;"><input type="text" class="fillblank" id="petNameInput" placeholder="Nombre de tu mascota" style="width:220px;"> '+
      '<button class="actionbtn" onclick="confirmPet()">Confirmar</button></div></div>';
  } else {
    const species=PETS[progress.pet.species];
    html+='<div class="card" style="text-align:center;">'+
      '<div style="font-size:5rem;line-height:1;">'+petBadgeHtml('5rem')+'</div>'+
      '<h3 style="margin-top:10px;">'+progress.pet.name+' — '+species.label+'</h3>'+
      '<p class="pill">'+st.label+'</p>'+
      '<p style="color:var(--text-dim);max-width:44ch;margin:8px auto;">'+st.desc+'</p>';
    if(nextSt){
      const need=levelOrder[stage];
      html+='<div class="progressbarwrap" style="max-width:300px;margin:10px auto;"><div class="progressbarfill" style="width:'+(stage*25)+'%"></div></div>'+
        '<p style="font-size:.85rem;color:var(--text-dim);">Aprueba el examen de <b>'+need+'</b> para evolucionar a "'+nextSt.label+'" '+nextSt.accessory+'</p>';
    } else {
      html+='<p style="color:var(--sage);font-weight:600;">🎉 ¡Nivel máximo alcanzado! Tu mascota ya domina todo el curso.</p>';
    }
    html+='</div>';
    html+='<div class="card"><h3>Línea de evolución</h3><div style="display:flex;flex-wrap:wrap;gap:18px;justify-content:center;">'+
      PET_STAGES.map(function(s,i){
        const reached = i<=stage;
        const glyph = i===0 ? s.emoji : species.base;
        return '<div style="text-align:center;opacity:'+(reached?'1':'.35')+';">'+
          '<div style="font-size:2.2rem;">'+glyph+(i>0&&s.accessory?'<span style="font-size:1.2rem;margin-left:-8px;">'+s.accessory+'</span>':'')+'</div>'+
          '<div style="font-size:.75rem;color:var(--text-dim);max-width:90px;">'+s.label+'</div></div>';
      }).join('')+'</div></div>';
    html+='<div class="card"><h3>Cambiar de compañero</h3><p style="color:var(--text-dim);font-size:.88rem;">Tu evolución no se pierde, solo cambia la especie o el nombre.</p>'+
      '<div class="grid3">'+Object.entries(PETS).map(function(e){
        return '<div class="note" style="text-align:center;cursor:pointer;'+(progress.pet.species===e[0]?'border-color:var(--sage);':'')+'" onclick="pickPetSpecies(\''+e[0]+'\',true)"><span style="font-size:2rem;">'+e[1].base+'</span><br>'+e[1].label+'</div>';
      }).join('')+'</div>'+
      '<div style="margin-top:12px;"><input type="text" class="fillblank" id="petRenameInput" placeholder="Nuevo nombre" style="width:220px;" value="'+progress.pet.name+'"> '+
      '<button class="actionbtn secondary" onclick="renamePet()">Renombrar</button></div></div>';
  }
  return html;
}
let pendingSpecies=null;
function pickPetSpecies(sp,immediate){
  if(immediate){ progress.pet.species=sp; saveProgress(); navigate('mascota'); return; }
  pendingSpecies=sp;
  document.querySelectorAll('#petPicker .note').forEach(function(n){ n.style.borderColor = n.dataset.species===sp ? 'var(--sage)' : 'var(--paper-line)'; });
}
function confirmPet(){
  const name=document.getElementById('petNameInput').value.trim();
  if(!pendingSpecies){ alert('Elige una especie primero.'); return; }
  if(!name){ alert('Ponle un nombre a tu mascota.'); return; }
  progress.pet={species:pendingSpecies,name:name};
  saveProgress(); renderSidebar(); navigate('mascota');
}
function renamePet(){
  const name=document.getElementById('petRenameInput').value.trim();
  if(!name) return;
  progress.pet.name=name; saveProgress(); renderSidebar(); navigate('mascota');
}

function renderProgreso(){
  return head('Tu avance','Mi progreso','Insignias ganadas, resultados por nivel y respaldo de tus datos.')+
  '<div class="card" style="cursor:pointer;" onclick="navigate(\'mascota\')"><h3>🐾 Tu mascota</h3><div style="display:flex;align-items:center;gap:14px;">'+petBadgeHtml('3rem')+
  '<div>'+(progress.pet?('<b>'+progress.pet.name+'</b><br><span class="pill">'+PET_STAGES[petStage()].label+'</span>'):'<b>Aún no tienes mascota</b><br><span class="pill">Toca para crear una</span>')+'</div></div></div>'+
  '<div class="card"><h3>Insignias</h3><div id="badgeList"></div></div>'+
  '<div class="card"><h3>Resultados por sección</h3><div id="scoreList"></div></div>'+
  '<div class="card"><h3>Respaldo de progreso</h3><p>Tu progreso se guarda automáticamente. También puedes exportarlo como archivo o restaurarlo en otro dispositivo.</p>'+
  '<button class="actionbtn" onclick="exportProgress()">⬇️ Exportar progreso</button> '+
  '<button class="actionbtn secondary" onclick="document.getElementById(\'importFile\').click()">⬆️ Importar progreso</button>'+
  '<input type="file" id="importFile" accept="application/json" style="display:none" onchange="importProgress(event)">'+
  '<button class="actionbtn secondary" onclick="if(confirm(\'¿Borrar todo tu progreso? (Tu mascota se mantendrá)\')){progress={quizzes:{},badges:[],theme:progress.theme,level:progress.level,pet:progress.pet};saveProgress();navigate(\'progreso\');}">🗑️ Reiniciar evaluaciones</button></div>';
}
function miniProgress(){
  const total=Object.keys(progress.quizzes).length;
  const pct=Math.min(100,Math.round(100*total/36));
  return '<div class="progressbarwrap"><div class="progressbarfill" style="width:'+pct+'%"></div></div><p style="font-size:.85rem;color:var(--text-dim);">'+total+' evaluaciones completadas en total · '+progress.badges.length+' insignias</p>';
}
function renderProgressPage(){
  const bl=document.getElementById('badgeList');
  if(bl) bl.innerHTML = progress.badges.length ? progress.badges.map(function(b){return '<span class="badge">🏅 '+b+'</span>';}).join('') : '<p style="color:var(--text-dim)">Aún no tienes insignias. ¡Completa un ejercicio para ganar la primera!</p>';
  const sl=document.getElementById('scoreList');
  if(sl){
    const entries=Object.entries(progress.quizzes);
    sl.innerHTML = entries.length ? table(['Sección','Puntaje','Fecha'], entries.map(function(e){return [e[0], e[1].score+'/'+e[1].total+' ('+Math.round(100*e[1].score/e[1].total)+'%)', e[1].date];})) : '<p style="color:var(--text-dim)">Aún no has completado ninguna evaluación.</p>';
  }
}
function exportProgress(){
  const blob=new Blob([JSON.stringify(progress,null,2)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='mi_progreso_ingles.json'; a.click();
}
function importProgress(ev){
  const file=ev.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=function(){
    try{ progress=JSON.parse(reader.result); saveProgress(); navigate('progreso'); alert('Progreso importado correctamente.'); }
    catch(e){ alert('Archivo inválido.'); }
  };
  reader.readAsText(file);
}

/* ============ INIT ============ */
loadProgress().then(function(){ navigate('inicio'); });
</script>
</body>
</html>
