function readingsPage(eyebrow,desc,readings){
  return head(eyebrow,'Lecturas cortas',desc)+readings.map(function(r,ri){
    return '<div class="card"><h3>'+r.title+'</h3><p>'+r.text+' '+speakBtn(r.text)+'</p>'+mcQuiz(r.id,r.questions)+'</div>';
